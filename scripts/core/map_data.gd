class_name MapData
extends RefCounted
## Static map layout: walls, bases, lanes and spawn points.
## Blue (team 0) sits bottom-left, Red (team 1) top-right. Red's data is
## the point-mirror of Blue's, so the map is fair by construction.

const LANE_TOP := 0
const LANE_MID := 1
const LANE_BOT := 2
const LANE_NAMES := ["Top", "Mid", "Bot"]

## '#' = wall, '.' = floor.
const DEFAULT_LAYOUT := [
	"###############",
	"#.............#",
	"#.............#",
	"#..##.####....#",
	"#..##.###.....#",
	"#..........#..#",
	"#..##.#...##..#",
	"#..##.....##..#",
	"#..##...#.##..#",
	"#..#..........#",
	"#.....###.##..#",
	"#....####.##..#",
	"#.............#",
	"#.............#",
	"###############",
]

var width := 0
var height := 0
var _walls := {}

## All of these are indexed by team (0 = Blue, 1 = Red).
var cores: Array[Vector2i] = []
var hero_spawns: Array = []      # [team] -> Array[Vector2i]
var towers: Array = []           # [team] -> Array of {"pos": Vector2i, "lane": int}
var minion_spawns: Array = []    # [team][lane] -> Vector2i
var lane_waypoints: Array = []   # [team][lane] -> Array[Vector2i], last one is the enemy core


func in_bounds(c: Vector2i) -> bool:
	return c.x >= 0 and c.y >= 0 and c.x < width and c.y < height


func is_wall(c: Vector2i) -> bool:
	return _walls.has(c)


func is_walkable(c: Vector2i) -> bool:
	return in_bounds(c) and not is_wall(c)


func mirror(c: Vector2i) -> Vector2i:
	return Vector2i(width - 1 - c.x, height - 1 - c.y)


static func create_default() -> MapData:
	var m := MapData.new()
	m._load_layout(DEFAULT_LAYOUT)

	# --- Blue side (bottom-left). Red is generated by mirroring. ---
	var blue_core := Vector2i(1, 13)
	var blue_heroes: Array[Vector2i] = [Vector2i(2, 13), Vector2i(1, 12)]
	var blue_towers := [
		{"pos": Vector2i(1, 7), "lane": LANE_TOP},
		{"pos": Vector2i(5, 9), "lane": LANE_MID},
		{"pos": Vector2i(7, 13), "lane": LANE_BOT},
	]
	var blue_spawns: Array[Vector2i] = [Vector2i(1, 10), Vector2i(3, 11), Vector2i(4, 13)]
	var red_core := m.mirror(blue_core)
	var blue_waypoints := [
		[Vector2i(2, 2), red_core],     # top: up the left edge, then right
		[red_core],                     # mid: straight up the diagonal
		[Vector2i(12, 12), red_core],   # bot: along the bottom, then up
	]

	m.cores = [blue_core, red_core]
	m.hero_spawns = [blue_heroes, blue_heroes.map(m.mirror)]
	m.towers = [blue_towers, blue_towers.map(func(t): return {"pos": m.mirror(t["pos"]), "lane": 2 - t["lane"]})]

	# Mirroring swaps top/bot: Red's top lane is the mirror of Blue's bot lane.
	var red_spawns := []
	var red_waypoints := []
	for lane in 3:
		red_spawns.append(m.mirror(blue_spawns[2 - lane]))
		red_waypoints.append(blue_waypoints[2 - lane].map(m.mirror))
	m.minion_spawns = [blue_spawns, red_spawns]
	m.lane_waypoints = [blue_waypoints, red_waypoints]
	return m


func _load_layout(rows: Array) -> void:
	height = rows.size()
	width = (rows[0] as String).length()
	_walls.clear()
	for y in height:
		var row: String = rows[y]
		for x in width:
			if row[x] == "#":
				_walls[Vector2i(x, y)] = true
